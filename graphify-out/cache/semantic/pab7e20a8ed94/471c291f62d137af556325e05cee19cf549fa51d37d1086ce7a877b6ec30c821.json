{"nodes": [{"id": "documenti_bibliografia_artificial_financial_market_paper", "label": "Using an artificial financial market for studying a cryptocurrency market (Cocco, Concas, Marchesi 2017)", "file_type": "paper", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "p.1", "source_url": "https://doi.org/10.1007/s11403-015-0168-2", "captured_at": null, "author": "Luisanna Cocco, Giulio Concas, Michele Marchesi", "contributor": null, "merged_from": ["checkpoint_1_lam_documenti_originale_file_bitcoin_cocco_concas_marchesi_2017", "dashboard_static_guida_cocco_concas_marchesi_2017"]}, {"id": "documenti_bibliografia_artificial_financial_market_agent_based_cryptocurrency_market", "label": "Agent-based Artificial Cryptocurrency Market", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_random_traders", "label": "Random Traders", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-intelligence traders acting for real needs; buy/sell with equal probability, active with p=0.1, act as a 'thermal bath' that stabilizes price."}, {"id": "documenti_bibliografia_artificial_financial_market_chartists", "label": "Chartists", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trend-following speculators (threshold Th=0.01 on relative price variation in window tau_i, active p=0.5); essential to reproduce fat tails and volatility clustering via herding."}, {"id": "documenti_bibliografia_artificial_financial_market_limit_order_book", "label": "Limit Order Book Price Clearing Mechanism", "file_type": "rationale", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single global order book judged a good first approximation of the many Bitcoin exchanges; buy orders sorted descending by limit, sells ascending, ties by issue time; transaction price = midpoint of limits, or min/max with current price for market orders. More realistic than daily aggregate clearing but alone yields poor fat tails with only Random traders."}, {"id": "documenti_bibliografia_artificial_financial_market_buy_sell_orders", "label": "Buy and Sell Orders (amount, limit price, expiration)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order size = available cash/bitcoin times lognormal beta (mean 0.25); limit prices p(t)*N(1.02,sigma_i) with sigma_i=K*volatility; market order prob 0.2 Random / 0.7 Chartist; no short selling."}, {"id": "documenti_bibliografia_artificial_financial_market_pareto_zipf_wealth", "label": "Pareto / Zipf Wealth Distribution", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial cash and bitcoin follow power law with alpha=1 (Zipf) via ranking property; realistic because trader financial power varies hugely; drives fat tails through order size."}, {"id": "documenti_bibliografia_artificial_financial_market_mining_modelling", "label": "Bitcoin Mining (implicit supply growth)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mining not explicitly modelled; new bitcoins assigned proportionally to randomly chosen Random traders at the real rate (incl. halving); Chartists excluded as inconsistent with miner behaviour."}, {"id": "documenti_bibliografia_artificial_financial_market_new_traders_inflow", "label": "New Traders Inflow (Blockchain unique addresses)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number of traders follows 30-day moving average of unique Blockchain addresses; newcomers have only cash; leaving traders sell all BTC via market order. Makes the market open and matches empirical data."}, {"id": "documenti_bibliografia_artificial_financial_market_stylized_facts", "label": "Stylized Facts of Financial Returns", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_unit_root_property", "label": "Unit Root Property", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_fat_tails", "label": "Fat Tail Phenomenon (excess kurtosis)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_volatility_clustering", "label": "Volatility Clustering", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_augmented_dickey_fuller_test", "label": "Augmented Dickey-Fuller Test", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_autocorrelation_absolute_returns", "label": "Autocorrelation of Raw vs Absolute Returns", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Fig. 5-6, Table 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_monte_carlo_simulations", "label": "Monte Carlo Simulations (100 runs)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_model_calibration", "label": "Model Calibration (1/100 scale, 830 daily steps)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 4.2, Table 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Market sized at 1/100 of real to manage computational load: Nt(0)=100, BT(0)=80000, p(0)=5$, CT(0)=400000$, Nt(tmax)=1500, K=0.01, Ti=30; calibrated on Jan 2012 - Apr 2014 Blockchain.info data."}, {"id": "documenti_bibliografia_artificial_financial_market_trader_wealth", "label": "Trader Wealth w_i(t) = c_i + b_i p(t)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 5.2, Eq. 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ratio of Random to Chartist wealth stays roughly constant, so the Chartist strategy is not winning over Random."}, {"id": "documenti_bibliografia_artificial_financial_market_gasm", "label": "Genoa Artificial Stock Market (GASM)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_heterogeneous_agent_models", "label": "Heterogeneous Agent Models (HAMs)", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_bitcoin", "label": "Bitcoin", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_blockchain", "label": "Blockchain / Blockchain.info data", "file_type": "concept", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "Sect. 1, 3.3", "source_url": "https://blockchain.info/", "captured_at": null, "author": null, "contributor": null}, {"id": "documenti_bibliografia_artificial_financial_market_raberto_2001", "label": "Raberto et al. 2001 - Agent-based simulation of a financial market", "file_type": "paper", "source_file": "documenti/bibliografia-artificial-financial-market.pdf", "source_location": "References", "source_url": null, "captured_at": null, "author": "Raberto, Cincotti, Focardi, Marchesi", "contributor": null}, {"id": "documenti_bibliografia_artifi